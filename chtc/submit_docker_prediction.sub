# Submit file
universe = docker
# link to self-built docker image
docker_image = yasuo0810/dinov2_chtc:v0.8

# set the executable to run
executable = ./run_prediction.sh
arguments = -i $(Process)

# set the log, error and output files
log = log/log$(Cluster)_$(Process).log
error = error/job$(Cluster)_$(Process).err
output = output/job$(Cluster)_$(Process).out

transfer_input_files = microdet.tar.gz, file:///staging/groups/caicedo_group/yren/micronuclei_project/20241114_pilot_validation_20X_c0_HeLa.tar.gz
transfer_output_files = microdet/20241114_pilot_validation_20X_c0_HeLa/model_output
transfer_output_remaps = "model_output = file:///staging/groups/caicedo_group/yren/micronuclei_project/model_output

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

request_cpus = 8
request_gpus = 1

+WantGPULab = true
+GPUJobLength = "medium"

request_memory = 80GB
request_disk = 80GB

Requirements = (Machine == "jcaicedogpu0001.chtc.wisc.edu")

queue 1596